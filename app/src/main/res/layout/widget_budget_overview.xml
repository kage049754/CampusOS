<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Budget" android:textStyle="bold" android:textSize="13sp" android:textColor="?android:attr/textColorPrimary"/>
    <LinearLayout android:id="@+id/budget_small_group" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/budget_small_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₱450" android:textStyle="bold" android:textSize="26sp" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="remaining" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/budget_medium_group" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/budget_medium_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₱450" android:textStyle="bold" android:textSize="26sp" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:id="@+id/budget_medium_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₱150 spent • Weekly" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
        <ProgressBar android:id="@+id/budget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="7dp" android:max="100" android:progress="75"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/budget_large_group" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/budget_large_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₱450" android:textStyle="bold" android:textSize="28sp" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:id="@+id/budget_large_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₱150 spent • ₱0 saved • Weekly" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
        <TextView android:id="@+id/budget_large_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="75% remaining" android:textStyle="bold" android:textSize="12sp" android:paddingTop="4dp" android:textColor="?android:attr/textColorPrimary"/>
        <ProgressBar android:id="@+id/budget_progress_large_dummy" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>