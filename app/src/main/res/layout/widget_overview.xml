<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:textSize="13sp" android:maxLines="1" android:textColor="?android:attr/textColorPrimary"/>
    <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:textSize="16sp" android:paddingTop="4dp" android:maxLines="2" android:textColor="?android:attr/textColorPrimary"/>
    <TextView android:id="@+id/widget_next_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:paddingTop="2dp" android:textColor="?android:attr/textColorSecondary"/>
    <TextView android:id="@+id/widget_schedule" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:paddingTop="7dp" android:maxLines="4" android:textColor="?android:attr/textColorPrimary"/>
    <TextView android:id="@+id/widget_tasks" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:paddingTop="7dp" android:maxLines="3" android:textColor="?android:attr/textColorSecondary"/>
</LinearLayout>