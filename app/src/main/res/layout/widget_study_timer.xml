<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Study Timer" android:textStyle="bold" android:textSize="13sp" android:textColor="?android:attr/textColorPrimary"/>
    <LinearLayout android:id="@+id/timer_small_group" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/timer_small_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="25:00" android:textStyle="bold" android:textSize="27sp" android:textColor="?android:attr/textColorPrimary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/timer_medium_group" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/timer_medium_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="25:00" android:textStyle="bold" android:textSize="30sp" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:id="@+id/timer_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="25-minute focus" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
        <TextView android:id="@+id/timer_start" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center" android:text="Start 25 min" android:textStyle="bold" android:background="?android:attr/selectableItemBackground" android:textColor="?android:attr/textColorPrimary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/timer_large_group" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/timer_large_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="25:00" android:textStyle="bold" android:textSize="34sp" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Focus session" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
        <TextView android:id="@+id/timer_reset" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center" android:text="Reset" android:textStyle="bold" android:background="?android:attr/selectableItemBackground" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:id="@+id/timer_start_large_dummy" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>