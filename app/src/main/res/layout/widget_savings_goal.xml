<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Savings Goal" android:textStyle="bold" android:textSize="13sp" android:textColor="?android:attr/textColorPrimary"/>
    <LinearLayout android:id="@+id/savings_small_group" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/savings_small_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="55%" android:textStyle="bold" android:textSize="28sp" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="saved" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/savings_medium_group" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/savings_medium_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New headphones" android:textStyle="bold" android:textSize="20sp" android:maxLines="1" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:id="@+id/savings_medium_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₱2,750 / ₱5,000" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
        <ProgressBar android:id="@+id/savings_medium_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="7dp" android:max="100" android:progress="55"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/savings_large_group" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/savings_large_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New headphones" android:textStyle="bold" android:textSize="21sp" android:maxLines="1" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:id="@+id/savings_large_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="₱2,250 left • 55% complete" android:textSize="13sp" android:paddingTop="3dp" android:textColor="?android:attr/textColorSecondary"/>
        <ProgressBar android:id="@+id/savings_large_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="7dp" android:max="100" android:progress="55"/>
    </LinearLayout>
</LinearLayout>