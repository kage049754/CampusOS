<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quick Expense" android:textStyle="bold" android:textSize="13sp" android:textColor="?android:attr/textColorPrimary"/>
    <LinearLayout android:id="@+id/quick_expense_small_group" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/quick_expense_small" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="+ Add Expense" android:textStyle="bold" android:textSize="17sp" android:background="?android:attr/selectableItemBackground" android:textColor="?android:attr/textColorPrimary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/quick_expense_medium_group" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/quick_expense_medium" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="+ Add Expense" android:textStyle="bold" android:textSize="20sp" android:background="?android:attr/selectableItemBackground" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Tap to choose category and amount" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/quick_expense_large_group" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Record a purchase" android:textStyle="bold" android:textSize="18sp" android:textColor="?android:attr/textColorPrimary"/>
        <TextView android:id="@+id/quick_expense_large" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:layout_marginTop="8dp" android:text="+ Add Expense" android:textStyle="bold" android:textSize="19sp" android:background="?android:attr/selectableItemBackground" android:textColor="?android:attr/textColorPrimary"/>
    </LinearLayout>
</LinearLayout>