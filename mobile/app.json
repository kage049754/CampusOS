{
  "expo": {
    "name": "CampusOS",
    "slug": "campusos",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "campusos",
    "android": {
      "package": "com.kage049754.campusos",
      "versionCode": 2,
      "minSdkVersion": 24,
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "USE_EXACT_ALARM"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-sqlite",
      "expo-document-picker",
      "expo-notifications",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-file-system",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "CampusNextClassWidget",
              "displayName": "CampusOS · Next Class",
              "description": "See your next scheduled class, time, and room.",
              "android": {
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "src/widgets/CampusNextClassWidget.tsx"
              }
            },
            {
              "name": "CampusTasksWidget",
              "displayName": "CampusOS · Tasks",
              "description": "See your pending task count and the next deadline.",
              "android": {
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "src/widgets/CampusTasksWidget.tsx"
              }
            }
          ]
        }
      ]
    ]
  }
}
